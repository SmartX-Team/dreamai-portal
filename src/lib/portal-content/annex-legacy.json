{
  "rootClass": "annex-page",
  "css": "\n        .annex-page {\n          max-width: 1120px;\n          margin: 0 auto;\n          padding: 4rem 2rem 6rem;\n          color: #18212b;\n        }\n\n        .annex-hero {\n          margin-bottom: 3rem;\n        }\n\n        .annex-label {\n          display: inline-block;\n          margin-bottom: 1rem;\n          padding: 9px 18px;\n          border: 1px solid #c8dced;\n          border-radius: 999px;\n          background: #f1f7fb;\n          color: #205b88;\n          font-size: 14px;\n          font-weight: 700;\n          letter-spacing: 0.04em;\n        }\n\n        .annex-title {\n          margin: 0 0 0.65rem;\n          color: #18212b;\n          font-size: 42px;\n          font-weight: 700;\n          letter-spacing: -0.04em;\n          line-height: 1.2;\n        }\n\n        .annex-subtitle {\n          margin: 0;\n          color: #77818c;\n          font-size: 18px;\n          line-height: 1.6;\n        }\n\n        .annex-main-image {\n          margin: 0 0 4rem;\n          overflow: hidden;\n          border-radius: 12px;\n          background: #f7f8fa;\n        }\n\n        .annex-main-image img {\n          display: block;\n          width: 100%;\n          height: auto;\n        }\n\n        .annex-intro {\n          max-width: 900px;\n          margin: 0 0 4.5rem;\n        }\n\n        .annex-intro-title {\n          margin: 0 0 0.8rem;\n          color: #18212b;\n          font-size: 22px;\n          font-weight: 700;\n          letter-spacing: -0.03em;\n        }\n\n        .annex-intro-text {\n          margin: 0;\n          color: #56616c;\n          font-size: 16px;\n          line-height: 1.9;\n          word-break: keep-all;\n        }\n\n        .annex-goals {\n          display: grid;\n          gap: 0.65rem;\n          margin: 1.5rem 0 0;\n          padding: 0;\n          list-style: none;\n        }\n\n        .annex-goals li {\n          position: relative;\n          padding-left: 1.1rem;\n          color: #68737e;\n          font-size: 15px;\n          line-height: 1.7;\n          word-break: keep-all;\n        }\n\n        .annex-goals li::before {\n          position: absolute;\n          left: 0;\n          color: #6b9bc0;\n          content: \"•\";\n        }\n\n        .annex-floor {\n          margin-top: 4.5rem;\n        }\n\n        .annex-floor-heading {\n          display: flex;\n          align-items: baseline;\n          gap: 1rem;\n          margin-bottom: 1.5rem;\n          padding-bottom: 0.8rem;\n          border-bottom: 1px solid #e4e8ec;\n        }\n\n        .annex-floor-heading h2 {\n          margin: 0;\n          color: #17212b;\n          font-size: 32px;\n          font-weight: 750;\n          letter-spacing: -0.04em;\n        }\n\n        .annex-floor-heading span {\n          color: #68737e;\n          font-size: 16px;\n        }\n\n        .annex-room {\n          display: grid;\n          grid-template-columns: 240px minmax(0, 1fr);\n          gap: 2rem;\n          align-items: center;\n          padding: 1.5rem 0;\n          border-bottom: 1px solid #edf0f2;\n        }\n\n        .annex-room-image {\n          position: relative;\n          width: 100%;\n          aspect-ratio: 16 / 10;\n          overflow: hidden;\n          border-radius: 8px;\n          background: #f2f4f6;\n        }\n\n        .annex-room-image img {\n          object-fit: cover;\n        }\n\n        .annex-room-number {\n          margin: 0 0 0.45rem;\n          color: #71808d;\n          font-size: 13px;\n          font-weight: 600;\n        }\n\n        .annex-room-title {\n          margin: 0 0 0.5rem;\n          color: #18212b;\n          font-size: 22px;\n          font-weight: 700;\n          letter-spacing: -0.035em;\n        }\n\n        .annex-room-description {\n          margin: 0;\n          color: #68737e;\n          font-size: 15px;\n          line-height: 1.7;\n          word-break: keep-all;\n        }\n\n        .annex-room-features {\n          margin: 0.75rem 0 0;\n          color: #8a949e;\n          font-size: 13px;\n          line-height: 1.8;\n          word-break: keep-all;\n        }\n\n        .annex-livinglab {\n          margin-top: 6rem;\n          padding-top: 3rem;\n          border-top: 1px solid #e4e8ec;\n          scroll-margin-top: 2rem;\n        }\n\n        .annex-livinglab-status {\n          margin: 0 0 1rem;\n          color: #71808d;\n          font-size: 15px;\n          font-weight: 600;\n        }\n\n        .annex-livinglab-description {\n          max-width: 900px;\n          margin: 0;\n          color: #68737e;\n          font-size: 15px;\n          line-height: 1.8;\n          word-break: keep-all;\n        }\n\n        .annex-livinglab-image {\n          position: relative;\n          width: 100%;\n          aspect-ratio: 16 / 9;\n          margin: 1.75rem 0 0;\n          overflow: hidden;\n          border-radius: 10px;\n          background: #f2f4f6;\n        }\n\n        .annex-livinglab-image img {\n          object-fit: contain;\n        }\n\n        @media (max-width: 700px) {\n          .annex-page {\n            padding: 3rem 1.25rem 4rem;\n          }\n\n          .annex-hero {\n            margin-bottom: 2rem;\n          }\n\n          .annex-title {\n            font-size: 34px;\n          }\n\n          .annex-subtitle {\n            font-size: 16px;\n          }\n\n          .annex-main-image {\n            margin-bottom: 3rem;\n            border-radius: 8px;\n          }\n\n          .annex-intro {\n            margin-bottom: 3.5rem;\n          }\n\n          .annex-intro-title {\n            font-size: 20px;\n          }\n\n          .annex-intro-text {\n            font-size: 15px;\n          }\n\n          .annex-goals {\n            gap: 0.55rem;\n            margin-top: 1.25rem;\n          }\n\n          .annex-goals li {\n            font-size: 14px;\n          }\n\n          .annex-floor {\n            margin-top: 3.5rem;\n          }\n\n          .annex-floor-heading {\n            align-items: flex-start;\n            flex-direction: column;\n            gap: 0.25rem;\n          }\n\n          .annex-floor-heading h2 {\n            font-size: 28px;\n          }\n\n          .annex-room {\n            grid-template-columns: 1fr;\n            gap: 1rem;\n            padding: 1.25rem 0;\n          }\n\n          .annex-room-image {\n            aspect-ratio: 16 / 9;\n          }\n\n          .annex-room-title {\n            font-size: 20px;\n          }\n\n          .annex-livinglab {\n            margin-top: 4.5rem;\n            padding-top: 2.5rem;\n          }\n\n          .annex-livinglab-image {\n            aspect-ratio: 16 / 10;\n            margin-top: 1.25rem;\n          }\n        }\n      ",
